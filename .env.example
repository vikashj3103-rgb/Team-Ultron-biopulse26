# ==============================================================================
# CareConnect Environment Configuration
# ==============================================================================

# Supabase Project Credentials (from your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Hardware API Base URL (ESP32 / smart glove integration)
VITE_API_BASE_URL=http://localhost:3001

# Local synthetic demo mode is opt-in and is ignored by production builds.
VITE_DEMO_MODE=false

# Server-side Vercel relay gate. Keep false in deployed environments.
HEALTHCONNECT_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Production Server-Side AI Gateway Configuration (Server-Only, Never in Client Bundle)
# ------------------------------------------------------------------------------
# In production, CareConnect clients communicate strictly with /api/clinical-ai.
# The server communicates with the internal OmniRoute gateway using these credentials.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_server_omniroute_api_key_here
OMNIROUTE_MODEL=antigravity/gemini-3-flash
